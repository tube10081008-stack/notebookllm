# ── LLM Provider ─────────────────────────────────────────────
# gemini | openai | mock
#   gemini : Google Gemini API (임시 — 빌린 API 단계)
#   openai : OpenAI 호환 API. Ollama/LM Studio/vLLM 등 로컬 오픈모델용.
#            (Ollama: LLM_BASE_URL=http://localhost:11434/v1)
#   mock   : API 키 없이 동작 확인용 (임베딩·생성 모두 결정적 더미)
LLM_PROVIDER=gemini

# gemini provider
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# openai-호환 provider (Ollama 예시)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_TEXT_MODEL=jay-qwen2.5:3b        # 파인튜닝한 페르소나 모델
# LLM_VISION_MODEL=qwen2.5-vl:7b       # 이미지/PDF OCR용 (선택)
# LLM_EMBED_MODEL=bge-m3               # 로컬 임베딩 (전환 시 npm run reindex 필수)

# 임베딩 차원 (모델과 반드시 일치. 벡터 파일에 함께 기록됨)
EMBED_DIMS=768

# ── 서버 ─────────────────────────────────────────────────────
PORT=3456
HOST=127.0.0.1

# API 인증 토큰. 설정하면 모든 /api 요청에 Bearer 토큰 필요.
# localhost 밖으로 노출(터널·배포)할 때는 반드시 설정할 것.
AUTH_TOKEN=

# 답변 시 노트를 "근거"로 인정할 최소 벡터 관련도 (미달 시 일반 지식 혼합 모드)
# RELEVANCE_FLOOR=0.45

# 사설망 URL 수집 허용 — 사내망 RSS 피드/로컬 테스트 전용 opt-in. 공개 서버에선 절대 금지.
# ALLOW_PRIVATE_NET=1

# ── 지식 워크스페이스 ─────────────────────────────────────────
# 진실의 원천. 10년 데이터가 쌓이는 곳.
# 반드시 별도의 private git 저장소로 관리할 것을 권장.
WORKSPACE_ROOT=./data
